# Copy this file to .env and fill in your values. .env is gitignored — never
# commit real credentials.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pyfinbot
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pyfinbot
# DB_ECHO=false

# --- Auth ---------------------------------------------------------------
# Signs JWT access tokens. If unset, a random key is generated on every
# process start (fine for local dev, but every restart invalidates all
# issued tokens) — set this explicitly for any deployment that needs to
# survive a restart.
SECRET_KEY=<a long random string>
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Web UI ---------------------------------------------------------------
# "local" (default) issues its own session cookie, verified against SECRET_KEY
# above. "forward_auth" (Authentik outpost) isn't wired up yet — deferred.
# AUTH_ADAPTER=local

# --- Roles --------------------------------------------------------------------
# ROLE_BOOTSTRAP makes users admins by id — the first admin (create them with
# scripts/create_user.py), and recovery. Roles assigned at /admin/roles are
# stored in the database instead. ROLE_GROUPS maps directory groups to roles
# (forward_auth/Authentik).
# ROLE_BOOTSTRAP=alice=admin
# ROLE_GROUPS=admins=admin

# --- Secret settings --------------------------------------------------------
# Each user sets their own email account for Commsec sync at /settings ›
# Email sync (the old server-wide GMAIL_* settings are no longer read). Their
# app password is stored encrypted with this Fernet key. Generate one with:
#   python -c "from greentechhub_core.settings.crypto import FernetCipher; print(FernetCipher.generate_key())"
# If unset, a key is derived from SECRET_KEY — then changing SECRET_KEY makes
# saved app passwords unreadable (users re-enter them).
SETTINGS_CIPHER_KEY=<a Fernet key>

# --- Environment & CORS -----------------------------------------------------
# "development" (default) allows all cross-origin requests when
# CORS_ALLOWED_ORIGINS is unset, for frictionless local/Swagger testing.
# "production" allows none by default — set CORS_ALLOWED_ORIGINS explicitly
# to permit any cross-origin access.
ENVIRONMENT=development
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Reverse proxy --------------------------------------------------------------
# Behind a reverse proxy (e.g. Caddy), list its address(es) so the real client
# IP comes from X-Forwarded-For. Without it every request looks like it comes
# from the proxy, and the login throttle locks everyone out together.
# TRUSTED_PROXIES=172.18.0.2

# --- Logging ------------------------------------------------------------------
# JSON lines on stdout, tagged with the service and version.
# LOG_LEVEL=INFO
